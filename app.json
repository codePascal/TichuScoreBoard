{
  "expo": {
    "name": "Tichu Scoreboard",
    "slug": "tichu-scoreboard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tichuscoreboard",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0e1a0e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tichuscoreboard.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0e1a0e"
      },
      "package": "com.tichuscoreboard.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-asset", "expo-font"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
